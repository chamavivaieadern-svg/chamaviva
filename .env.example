NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endpoint OSRM compatível para cálculo de rotas; use provedor próprio em produção.
NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org

# Somente servidor (Netlify environment variables). Nunca prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# RESEND_API_KEY e EMAIL_WEBHOOK_SECRET são configurados como secrets da Edge Function no Supabase.
